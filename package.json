    "hono": "^4.6.14",
    "ssh2": "^1.16.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "latest",
    "@types/ssh2": "^1.15.4",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.3"
  }
