# ==========================================
# PikiLand 🏰 Spring Boot Environment Variables
# ==========================================

# 1. AI Gateway Configuration (OpenAI-compatible)
AI_BASE_URL="https://example.ai/v1/gateway"
AI_API_KEY="your_openai_api_key_here"
AI_MODEL="gpt-4o"
DRY_RUN="true"

# 2. GitHub App Integration Configuration
GITHUB_APP_ID="your_github_app_id_here"
GITHUB_PRIVATE_KEY_PATH="github-app-private-key.pem"
GITHUB_WEBHOOK_SECRET="your_webhook_signature_secret_here"

# 3. GitHub OAuth 2.0 Web Dashboard Login Settings
GITHUB_CLIENT_ID="your_oauth_client_id_here"
GITHUB_CLIENT_SECRET="your_oauth_client_secret_here"

# 4. Production Database Settings (Only used in DRY_RUN="true")
DATABASE_URL="jdbc:postgresql://localhost:5432/pikilanddb"
DATABASE_USER="postgres"
DATABASE_PASSWORD="your_db_password"