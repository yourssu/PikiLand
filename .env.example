# ==========================================
# PikiLand Coordinator Configuration
# ==========================================

# 1. Admin & Security
# Comma-separated list of GitHub usernames with Admin privileges (/admin access)
PIKILAND_ADMIN_USERS="your_github_username"

# Debug mode (true skips webhook signature verification AND repo-ownership
# authorization entirely — broad bypass, MUST BE false in production)
DEBUG="false"

# UI preview mode (true skips only the GitHub OAuth login requirement, so
# /dashboard and /admin can be opened directly for manual UI checks or
# Playwright tests. Does NOT affect webhook verification or repo-ownership
# checks. Safe-by-construction: both this and DEBUG are force-disabled
# whenever NODE_ENV=production, regardless of their value here.)
PIKILAND_UI_PREVIEW="false"

# 2. GitHub OAuth (Dashboard login)
# Obtain from GitHub Developer Settings -> GitHub Apps / OAuth Apps
GITHUB_CLIENT_ID="Ov23zXXXXXXXXXXXXXXX"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"

# 3. GitHub App Credentials (Can also be configured via Web UI at /admin)
GITHUB_APP_ID="123456"
GITHUB_PRIVATE_KEY_PATH="./pikiland-app.pem"
GITHUB_WEBHOOK_SECRET="your_webhook_secret_here"

# 4. Server & Networking
PORT="8080"
PIKILAND_SERVER_URL="https://pikiland.yourdomain.com"

# 5. Database Storage
DATABASE_PATH="./data/pikiland.sqlite"

# 6. Global AI Provider (Coordinator analysis fallback)
GLOBAL_AI_BASE_URL="https://api.openai.com/v1"
GLOBAL_AI_API_KEY="sk-proj-..."
GLOBAL_AI_MODEL="gpt-4o"
