# ======================================================================
# PikiLand 🏰 Central Control Plane Server Minimal Configuration
# ======================================================================
# NOTE: All GitHub App credentials (App ID, Private Key, Webhook Secret)
# and OAuth credentials (Client ID, Client Secret) are managed securely
# via the Admin Web UI (/dashboard) and stored in the database.
# ======================================================================

# 1. Central Admin Identification
# GitHub username(s) granted admin access to central system settings (comma-separated, default: empty)
PIKILAND_ADMIN_USERS=""

# 2. Production Database Infrastructure Settings (Used with 'prod' profile)
DATABASE_URL="jdbc:postgresql://localhost:5432/pikilanddb"
DATABASE_USER="postgres"
DATABASE_PASSWORD="your_db_password"

# 3. Debugging & Security Bypass Configuration (default: false)
DEBUG="false"