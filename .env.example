# OpenAI 규격 API Gateway Base URL
BASE_URL="https://example.ai/v1/gateway"

# AI API 인증 키 (OpenAI 혹은 호환 API Key)
API_KEY="your_openai_api_key_here"

# Slack 알림 Incoming Webhook URL
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/your/webhook/url"

# 분석에 사용할 AI 모델 (선택 사항, 기본값: gpt-5.4-mini)
AI_MODEL="your-ai-model"